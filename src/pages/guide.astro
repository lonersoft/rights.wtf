---
import Page from "../components/Page.astro";
import Badge from "../components/Badge.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import Footer from "../components/Footer.astro";

const topics = [
	{
		title: "decriminalization",
		body: "whether being queer is legal at all, and what the actual penalties look like.",
	},
	{
		title: "marriage & partnership",
		body: "marriage, civil unions, and the practical rights that come with them.",
	},
	{
		title: "legal gender recognition",
		body: "how (and whether) you can change your name and gender marker on official documents.",
	},
	{
		title: "conversion practices",
		body: "whether so-called conversion therapy is banned, restricted, or still legal.",
	},
	{
		title: "asylum & refuge",
		body: "where you can seek protection if staying where you are is not safe.",
	},
];

const identities = ["trans", "non-binary", "asexual", "bi / pan", "questioning"];
---

<Page
	title="guide — rights.wtf"
	description="A plain-language queer field guide: identities, legal topics, and where to start when everything feels like too much."
	width="6xl"
>
	<a href="/" class="text-xs font-semibold text-accent hover:underline">&larr; home</a>

	<h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">the queer field guide</h1>
	<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
		starting out, figuring things out, or just trying to exist — here is the stuff worth knowing,
		written like a person instead of a legal gazette.
	</p>

	<div class="mt-5 flex flex-wrap gap-2 text-[11px] font-semibold">
		<Badge tone="accent" size="md">plain language</Badge>
		<Badge tone="ok" size="md">sourced</Badge>
		<Badge tone="warn" size="md">honest about gaps</Badge>
	</div>

	<section class="mt-10" aria-labelledby="identities-heading">
		<h2 id="identities-heading" class="text-lg font-bold text-ink">the totally™ complete list of queer identities</h2>
		<p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-faint">
			realistically you do not need a fixed label. but if it helps you get an idea, start here.
		</p>
		<div class="mt-4 flex flex-wrap gap-2 text-[11px]">
			{identities.map((identity) => (
				<span class="rounded-lg bg-accent-soft px-2.5 py-1 font-medium text-accent-strong">
					{identity}
				</span>
			))}
		</div>
	</section>

	<section class="mt-10" aria-labelledby="topics-heading">
		<h2 id="topics-heading" class="text-lg font-bold text-ink">what we cover</h2>
		<p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-faint">
			every country page is built from the same five questions, so you can compare places without
			reading five different websites.
		</p>
		<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
			{topics.map((topic) => (
				<Card padding="sm">
					<h3 class="text-sm font-bold text-ink">{topic.title}</h3>
					<p class="mt-1.5 text-xs leading-relaxed text-ink-muted">{topic.body}</p>
				</Card>
			))}
		</div>
	</section>

	<section class="mt-10 rounded-2xl border border-line bg-accent-soft/40 p-5" aria-labelledby="start-heading">
		<h2 id="start-heading" class="text-lg font-bold text-ink">where do i actually start?</h2>
		<ol class="mt-3 space-y-2 text-xs leading-relaxed text-ink-muted">
			<li><strong class="font-bold text-ink">1.</strong> pick where you live (or where you are going) in the country directory.</li>
			<li><strong class="font-bold text-ink">2.</strong> read the topics that matter to you right now — not all five at once.</li>
			<li><strong class="font-bold text-ink">3.</strong> check the sources under any claim before acting on it.</li>
			<li><strong class="font-bold text-ink">4.</strong> if something is missing, tell us. that is how this gets better.</li>
		</ol>
		<Button
			href="/countries"
			variant="primary"
			size="sm"
			shape="pill"
			class="mt-4"
		>
			browse every jurisdiction &rarr;
		</Button>
	</section>

	<div class="mt-6 flex items-center justify-center gap-1.5 rounded-xl bg-accent-soft/70 p-2.5 text-center text-xs font-semibold text-accent-strong">
		<span>remember to take ur time</span>
	</div>

	<Footer slot="footer" />
</Page>

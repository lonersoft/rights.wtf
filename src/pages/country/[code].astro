---
import Page from "../../components/Page.astro";
import Badge from "../../components/Badge.astro";
import Button from "../../components/Button.astro";
import TopicRow from "../../components/TopicRow.astro";
import HelplineCard from "../../components/HelplineCard.astro";
import AtlasLayout from "../../components/AtlasLayout.astro";
import { GLOBAL_FALLBACK_HELPLINE } from "../../lib/helplines";
import {
	getAllJurisdictions,
	TOPIC_LABELS,
	type ResolvedJurisdiction,
	type Jurisdiction,
} from "../../lib/jurisdictions";
import { COVERAGE } from "../../lib/status";

export async function getStaticPaths() {
	const all = await getAllJurisdictions();
	return all.map((j) => ({ params: { code: j.code }, props: { j, all } }));
}

interface Props {
	j: ResolvedJurisdiction;
	all: ResolvedJurisdiction[];
}

const { j, all } = Astro.props;
const data: Jurisdiction | null = j.authored;
const children = all.filter((x) => x.parent === j.code);
const parent = j.parent ? all.find((x) => x.code === j.parent) ?? null : null;

const topicKeys = Object.keys(TOPIC_LABELS) as (keyof Jurisdiction["topics"])[];
const known = data
	? topicKeys.filter((k) => data.topics[k].status !== "unknown").length
	: 0;
---

<Page
	title={`${j.name} — rights.wtf`}
	description={`What the law says for queer people in ${j.name}. Sourced, plain language, no legal jargon.`}
	image={`/og/${j.code}.svg`}
	width="full"
>
	<AtlasLayout currentCode={j.code} jurisdictions={all}>
		<a href="/countries" class="lg:hidden text-xs font-semibold text-accent hover:underline">&larr; all jurisdictions</a>

	<div class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-2">
		<h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{j.name}</h1>
		<Badge tone={COVERAGE[j.coverage].tone} size="sm">
			{COVERAGE[j.coverage].label}
		</Badge>
	</div>

	{parent && (
		<p class="mt-1 text-xs text-ink-faint">
			Part of <a href={`/country/${parent.code}`} class="text-accent hover:underline">{parent.name}</a>
		</p>
	)}

	{data?.verification === "imported" && (
		<div class="mt-5 rounded-xl border border-warn-line bg-warn-soft p-4 text-xs text-warn">
			<strong class="font-bold">imported, not yet checked against primary law.</strong>
			This page was seeded from human-rights monitors. Treat it as a starting point and verify
			before making decisions. Sources are linked under each topic.
		</div>
	)}

	{data?.verification === "submitted" && (
		<div class="mt-5 rounded-xl border border-line bg-accent-soft p-4 text-xs text-accent-ink">
			<strong class="font-bold">submitted by a contributor, not yet checked.</strong>
			Someone sent us this through the contribution form and a maintainer has not verified it
			against primary law yet. Read the sources under each topic before relying on it.
		</div>
	)}

	{!data && (
		<div class="mt-6 rounded-2xl border border-line bg-accent-soft/40 p-5 text-sm text-ink-muted">
			<strong class="font-bold text-ink">we don't have verified legal info for {j.name} yet.</strong>
			<p class="mt-1 text-xs leading-relaxed">
				That is not a "no" — it means nobody has checked the law and written it down. If you
				know this country, you can fix that:
			</p>
			<Button
				href={`https://github.com/lonersoft/rights.wtf/issues/new?template=incorrect_info.yml&title=${encodeURIComponent(`[${j.name}] legal info needed`)}`}
				variant="primary"
				size="sm"
				shape="pill"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-3"
			>
				send us the law &rarr;
			</Button>
		</div>
	)}

	{data && (
		<dl class="mt-8 divide-y divide-line border-y border-line">
			{topicKeys.map((key) => (
				<TopicRow
					label={TOPIC_LABELS[key]}
					status={data.topics[key].status}
					summary={data.topics[key].summary}
					since={data.topics[key].since}
					sources={data.topics[key].sources}
				/>
			))}
		</dl>
	)}

	<section class="mt-8">
		<h2 class="text-lg font-bold">helplines</h2>
		<ul class="mt-3 grid gap-3 sm:grid-cols-2">
			{data && data.helplines.length > 0 ? (
				data.helplines.map((h) => (
					<HelplineCard name={h.name} contact={h.contact} url={h.url} />
				))
			) : (
				<HelplineCard
					title={GLOBAL_FALLBACK_HELPLINE.title}
					name={GLOBAL_FALLBACK_HELPLINE.name}
					note={GLOBAL_FALLBACK_HELPLINE.note}
					url={GLOBAL_FALLBACK_HELPLINE.url}
					linkLabel={GLOBAL_FALLBACK_HELPLINE.linkLabel}
				/>
			)}
		</ul>
	</section>

	{children.length > 0 && (
		<section class="mt-8">
			<h2 class="text-lg font-bold">where it varies</h2>
			<p class="mt-1 text-xs text-ink-faint">Law changes inside {j.name}. Pick where you are:</p>
			<ul class="mt-3 flex flex-wrap gap-2">
				{children.map((c) => (
					<li>
						<Button href={`/country/${c.code}`} variant="outline" size="sm" shape="pill">
							{c.name}
						</Button>
					</li>
				))}
			</ul>
		</section>
	)}

	<div class="mt-8 flex flex-wrap items-center justify-between gap-2 rounded-xl border border-line bg-accent-soft/40 px-4 py-3 text-xs">
		<span class="text-ink-muted">know this law better than we do?</span>
		<a
			href={`/contribute/${j.code}`}
			class="font-bold text-accent hover:text-accent-strong hover:underline"
		>
			contribute a correction &rarr;
		</a>
	</div>

	<div class="mt-10 rounded-xl border border-line bg-accent-soft/40 p-4 text-xs leading-relaxed text-ink-muted">
		<strong class="font-bold text-ink">this is not legal advice.</strong>{" "}
		We are not your attorneys. Laws change and enforcement varies. Check with a local advocacy
		group before acting. Spotted an error?{" "}
		<a
			href="https://github.com/lonersoft/rights.wtf/issues/new?template=incorrect_info.yml"
			target="_blank"
			rel="noopener noreferrer"
			class="font-semibold text-accent hover:underline"
		>
			tell us
		</a>.
	</div>

	{data && (
		<p class="mt-4 text-[11px] text-ink-faint">
			{known}/5 topics written
			{data.updatedAt && <> · updated {data.updatedAt}</>}
		</p>
	)}
	</AtlasLayout>
</Page>

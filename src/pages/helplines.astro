---
import Page from "../components/Page.astro";
import Badge from "../components/Badge.astro";
import HelplineCard from "../components/HelplineCard.astro";
import Footer from "../components/Footer.astro";
import { FEATURED_HELPLINES } from "../lib/helplines";
import { COMMUNITIES } from "../lib/communities";

const globalHelplines = FEATURED_HELPLINES.filter((h) => !h.scope || h.scope === "global");
const countryHelplines = FEATURED_HELPLINES.filter((h) => h.scope === "country");
const globalCommunities = COMMUNITIES.filter((c) => !c.scope || c.scope === "global");
const countryCommunities = COMMUNITIES.filter((c) => c.scope === "country");

const addCommunityUrl = `https://github.com/lonersoft/rights.wtf/issues/new?template=incorrect_info.yml&title=${encodeURIComponent("[Community] Add a community")}`;
---

<Page
	title="helplines & communities — rights.wtf"
	description="Free, confidential crisis and peer support, plus local and national LGBTQ+ communities around the world."
	width="6xl"
>
	<a href="/" class="text-xs font-semibold text-accent hover:underline">&larr; home</a>

	<h1 class="mt-4 text-3xl font-extrabold tracking-tight sm:text-4xl">helplines &amp; communities</h1>
	<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">
		vetted, free, non-judgmental crisis and peer support around the world, plus local and national
		groups you can actually go to. if you are in immediate danger, contact your local emergency
		number first.
	</p>

	<div class="mt-5 flex flex-wrap gap-2 text-[11px] font-semibold">
		<Badge tone="accent" size="md">24/7</Badge>
		<Badge tone="ok" size="md">anonymous</Badge>
		<Badge tone="info" size="md">confidential</Badge>
	</div>

	{/* Location indicator */}
	<div class="mt-6 flex items-center gap-2 rounded-xl border border-line/70 bg-accent-soft/40 p-3 text-xs text-ink-muted">
		<span class="font-medium text-ink-faint">showing resources for:</span>
		<span id="resources-geo" class="inline-flex items-center gap-1.5 font-bold text-accent-strong">
			<span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
			<span id="resources-geo-label">detecting location...</span>
		</span>
	</div>

	{/* Worldwide helplines: always visible. */}
	<section class="mt-10" aria-labelledby="global-helplines-heading">
		<h2 id="global-helplines-heading" class="text-lg font-bold text-ink">worldwide &amp; global</h2>
		<p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-faint">
			these work wherever you are, even if we do not have a local helpline listed for your country.
		</p>
		<ul class="mt-4 grid grid-cols-1 gap-4 text-xs sm:grid-cols-2 md:grid-cols-3">
			{globalHelplines.map((h) => <HelplineCard {...h} />)}
		</ul>
	</section>

	{/* Country helplines: only the detected country/region. */}
	<section class="mt-10" aria-labelledby="country-helplines-heading">
		<h2 id="country-helplines-heading" class="text-lg font-bold text-ink">helplines in your country</h2>
		<p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-faint">
			local services that know the laws, languages, and support systems where you live.
		</p>
		<div
			id="country-helplines-warning"
			class="mt-3 hidden rounded-xl border border-warn-line bg-warn-soft p-3 text-xs leading-relaxed text-warn"
			role="status"
		></div>
		<ul id="country-helplines-list" class="mt-4 grid grid-cols-1 gap-4 text-xs sm:grid-cols-2 md:grid-cols-3">
			{countryHelplines.map((h) => <HelplineCard {...h} hidden />)}
		</ul>
	</section>

	{/* Communities: global groups always visible, local groups filtered. */}
	<section class="mt-10" aria-labelledby="communities-heading">
		<h2 id="communities-heading" class="text-lg font-bold text-ink">communities</h2>
		<p class="mt-1 max-w-2xl text-xs leading-relaxed text-ink-faint">
			local, national, and global groups to join, volunteer with, or lean on — not just crisis lines.
		</p>
		<div class="mt-3 flex items-start gap-2 rounded-xl border border-line/70 bg-accent-soft/40 p-3 text-xs leading-relaxed text-ink-muted">
			<span>
				communities are non-exhaustive and depend on community support. if you know a community
				that isn't listed,{" "}
				<a
					href={addCommunityUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="font-semibold text-accent hover:underline"
				>
					click here to add one
				</a>.
			</span>
		</div>
		<div
			id="communities-warning"
			class="mt-3 hidden rounded-xl border border-warn-line bg-warn-soft p-3 text-xs leading-relaxed text-warn"
			role="status"
		></div>
		<ul id="communities-list" class="mt-4 grid grid-cols-1 gap-4 text-xs sm:grid-cols-2 md:grid-cols-3">
			{globalCommunities.map((c) => <HelplineCard {...c} />)}
			{countryCommunities.map((c) => <HelplineCard {...c} hidden />)}
		</ul>
	</section>

	<div class="mt-10 flex flex-col items-center justify-center gap-1.5 rounded-full border border-line-strong bg-accent-soft/80 px-6 py-3.5 text-center text-xs text-ink sm:flex-row sm:text-sm">
		<span>need something else? search every country's services at</span>
		<a
			href="https://findahelpline.com"
			target="_blank"
			rel="noopener noreferrer"
			class="font-bold text-accent-strong underline transition-colors hover:text-accent-ink"
		>
			findahelpline.com.
		</a>
	</div>

	<Footer slot="footer" />
</Page>

<script>
	import "../scripts/resources";
</script>

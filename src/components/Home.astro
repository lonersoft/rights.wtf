---
import Page from "./Page.astro";
import Card from "./Card.astro";
import Badge from "./Badge.astro";
import Button from "./Button.astro";
import Select from "./Select.astro";
import HelplineCard from "./HelplineCard.astro";
import Footer from "./Footer.astro";
import { getCollection } from "astro:content";
import { coverageOf } from "../lib/jurisdictions";
import { COVERAGE, coverageBadgeClass } from "../lib/status";
import { FEATURED_HELPLINES } from "../lib/helplines";

// rights.wtf - Homepage

const entries = (await getCollection("jurisdictions"))
	.filter((e) => coverageOf(e.data) !== "stub")
	.sort((a, b) => a.data.name.localeCompare(b.data.name));

const countries = entries.filter((e) => !e.data.parent);
const regions = entries.filter((e) => e.data.parent);

const topicOrder = ["decriminalization", "marriage", "genderRecognition", "conversionTherapy"] as const;

const preview = entries.map((e) => ({
	code: e.data.code,
	name: e.data.name,
	coverage: coverageOf(e.data),
	topics: topicOrder.map((k) => ({
		key: k,
		status: e.data.topics[k].status,
		summary: e.data.topics[k].summary,
	})),
}));

const first = preview.find((p) => p.code === countries[0]?.data.code) ?? preview[0];
const json = JSON.stringify(preview).replace(/</g, "\\u003c");

const helplines = FEATURED_HELPLINES;
---

<Page width="6xl">
	<Fragment slot="wash">
		<div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(ellipse_80%_50%_at_50%_0%,var(--wash),transparent)]"></div>
	</Fragment>

	{/* Hero */}
	<div class="mx-auto mb-10 max-w-3xl text-center sm:mb-12">
		<h1 class="text-3xl font-extrabold leading-tight tracking-tight text-ink sm:text-5xl">
			no but actually, what <span class="font-black text-accent underline decoration-accent decoration-wavy decoration-2">THE FUCK</span> are rights?
		</h1>
		<p class="mt-4 text-base leading-relaxed text-ink-muted sm:text-lg">
			well, welcome to your first steps. welcome to the club! <span class="block font-normal text-ink-faint sm:inline">(and welcome if you're also not queer)</span>
		</p>
	</div>

	{/* Three cards */}
	<div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-3">
		{/* Card 1: country quick-sheet */}
		<Card id="directory" class="flex scroll-mt-24 flex-col justify-between" interactive>
			<div>
				<div class="mb-2 flex items-center gap-2">
					<svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<h2 class="text-lg font-bold text-ink">quick! give me informations!!</h2>
				</div>
				<p class="mb-4 text-xs leading-relaxed text-ink-muted">
					Find your legal protections, transition rules, and safety reality right where you live.
				</p>

				<Select id="country-selector" label="Select your country or region:">
					<optgroup label="Countries">
						{countries.map((e) => (
							<option value={e.data.code} selected={e === countries[0]}>{e.data.name}</option>
						))}
					</optgroup>
					{regions.length > 0 && (
						<optgroup label="US states & regions (laws vary wildly)">
							{regions.map((e) => (
								<option value={e.data.code}>{e.data.name}</option>
							))}
						</optgroup>
					)}
				</Select>

				{/* Dynamic legal quick-sheet snippet */}
				<div id="quick-info-box" class="mt-4 space-y-2 rounded-xl border border-line bg-accent-soft/40 p-3.5 text-xs">
					<div class="flex items-center justify-between gap-2 pb-1.5">
						<span class="font-bold text-ink" id="info-country-name">{first?.name ?? "—"}</span>
						<span class={coverageBadgeClass(first?.coverage ?? "stub")} id="info-status-badge">
							{first ? COVERAGE[first.coverage].short : "not verified"}
						</span>
					</div>
					<div class="space-y-1.5 text-ink-muted" id="info-rows"></div>
					<a
						id="info-full-link"
						href={first ? `/country/${first.code}` : "/countries"}
						class="mt-1 inline-flex items-center gap-1 font-bold text-accent hover:text-accent-strong hover:underline"
					>
						read the full page &rarr;
					</a>
				</div>
			</div>

			<div class="mt-5 pt-2 text-center">
				<a href="/countries" class="text-xs font-semibold text-accent hover:text-accent-strong hover:underline">
					(or browse every jurisdiction &rarr;)
				</a>
			</div>
		</Card>

		{/* Card 2: who are we? */}
		<Card id="about" class="flex scroll-mt-24 flex-col justify-between" interactive>
			<div>
				<div class="mb-2 flex items-center gap-2">
					<svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
					</svg>
					<h2 class="text-lg font-bold text-ink">who are we?</h2>
				</div>

				<p class="mb-3 rounded-xl border border-line/60 bg-accent-soft/50 p-3 font-serif text-base italic text-ink">
					"nobody, really. two students."
				</p>

				<p class="mb-4 text-xs leading-relaxed text-ink-muted">
					no but we really want to help queer people. as a silly little site project because reading 90-page legal gazettes when you're overwhelmed is the worst.
				</p>

				<Badge tone="accent" border={false} size="md">
					<svg class="h-3.5 w-3.5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
					</svg>
					<span>(not pro health info)</span>
				</Badge>
			</div>

			<div class="mt-5 pt-2">
				<a href="https://github.com/lonersoft/rights.wtf#why-this-exists" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs font-semibold text-ink-muted hover:text-accent">
					<span>read our story and method</span>
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>
		</Card>

		{/* Card 3: starting? unsure? */}
		<Card id="guide" class="flex scroll-mt-24 flex-col justify-between" interactive>
			<div>
				<div class="mb-2 flex items-center gap-2">
					<svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
					</svg>
					<h2 class="text-lg font-bold text-ink">starting? unsure?</h2>
				</div>

				<p class="mb-2 text-sm font-semibold leading-snug text-ink">
					the totally™ complete and full list of queer identities
				</p>

				<p class="mb-4 text-xs leading-relaxed text-ink-faint">
					(realistically you don't need a fixed label but it can help u get an idea)
				</p>

				<div class="mb-4 flex flex-wrap gap-1.5 text-[11px]">
					<span class="rounded-lg bg-accent-soft px-2 py-0.5 font-medium text-accent-strong">trans</span>
					<span class="rounded-lg bg-accent-soft px-2 py-0.5 font-medium text-accent-strong">non-binary</span>
					<span class="rounded-lg bg-accent-soft px-2 py-0.5 font-medium text-accent-strong">asexual</span>
					<span class="rounded-lg bg-accent-soft px-2 py-0.5 font-medium text-accent-strong">bi / pan</span>
					<span class="rounded-lg bg-accent-soft px-2 py-0.5 font-medium text-accent-strong">questioning</span>
				</div>

				<div class="flex items-center justify-center gap-1.5 rounded-xl bg-accent-soft/70 p-2.5 text-center text-xs font-semibold text-accent-strong">
					<svg class="h-3.5 w-3.5 text-accent" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
					</svg>
					<span>remember to take ur time</span>
				</div>
			</div>

			<div class="mt-5 pt-2">
				<a href="https://github.com/lonersoft/rights.wtf#what-we-cover" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between text-xs font-semibold text-accent hover:text-accent-strong">
					<span>explore queer field guide</span>
					<span aria-hidden="true">&rarr;</span>
				</a>
			</div>
		</Card>
	</div>

	{/* Helplines */}
	<section id="helplines" class="mb-10 scroll-mt-24">
		<Card padding="lg">
			<div class="mb-4 flex flex-col justify-between gap-4 pb-2 sm:flex-row sm:items-center">
				<div>
					<div class="flex items-center gap-2">
						<svg class="h-5 w-5 text-bad" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m0 0l-2.829-2.829m2.829 2.829L21 21M15.536 8.464a5 5 0 010 7.072m0 0l-2.829-2.829m-4.243 2.829a4.978 4.978 0 01-1.414-2.83m-1.414 5.658a9 9 0 01-2.167-9.238m7.824 2.167a1 1 0 111.414 1.414m-1.414-1.414L3 3m8.293 8.293l1.414 1.414" />
						</svg>
						<h3 class="text-xl font-bold text-ink">helplines (per country)</h3>
					</div>
					<p class="mt-1 text-xs text-ink-faint">
						vetted, free, non-judgmental crisis and peer support around the world.
					</p>
				</div>
				<Badge tone="accent" size="md" class="self-start sm:self-auto">
					24/7 • anonymous • confidential
				</Badge>
			</div>

			{/* Location indicator based on IP */}
			<div class="mb-6 flex items-center gap-2 rounded-xl border border-line/70 bg-accent-soft/40 p-3 text-xs text-ink-muted">
				<span class="font-medium text-ink-faint">your detected country:</span>
				<span id="user-geo-country" class="inline-flex items-center gap-1.5 font-bold text-accent-strong">
					<span class="inline-block h-2 w-2 rounded-full bg-accent" aria-hidden="true"></span>
					<span>detecting location...</span>
				</span>
			</div>

			<ul class="grid grid-cols-1 gap-4 text-xs sm:grid-cols-2 md:grid-cols-4">
				{helplines.map((h) => <HelplineCard {...h} />)}
			</ul>
		</Card>
	</section>

	{/* Immediate-help banner */}
	<div class="flex flex-col items-center justify-center gap-1.5 rounded-full border border-line-strong bg-accent-soft/80 px-6 py-3.5 text-center text-xs text-ink sm:flex-row sm:text-sm">
		<span>need immediate assistance? help is available, 24/7 and anonymously.</span>
		<a
			href="https://findahelpline.com"
			target="_blank"
			rel="noopener noreferrer"
			class="font-bold text-accent-strong underline transition-colors hover:text-accent-ink"
		>
			visit findahelpline.com.
		</a>
	</div>

	<Footer slot="footer" />
</Page>

<script type="application/json" id="jurisdiction-data" is:inline set:html={json}></script>

<script>
	import "../scripts/home";
</script>

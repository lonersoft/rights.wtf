---
import type { HTMLAttributes } from "astro/types";
import { FIELD_CLASS } from "../lib/ui";

type Props = Omit<HTMLAttributes<"input">, "id"> & {
	id: string;
	label: string;
	/** Visually hide the label but keep it for screen readers. */
	hideLabel?: boolean;
};

const { id, label, hideLabel = false, class: className, ...rest } = Astro.props;
---

<label class="block" for={id}>
	<span class={hideLabel ? "sr-only" : "mb-1.5 block text-xs font-semibold text-ink-muted"}>
		{label}
	</span>
	<input id={id} class:list={[FIELD_CLASS, className]} {...rest} />
</label>

---
// Shared site header: brand, nav, persistent quick exit, mobile menu.
// Quick exit must never be dismissible — it is the one safety control that
// has to be on every page, on every screen size.
import Button from "./Button.astro";
---

<header class="w-full bg-surface/90 backdrop-blur-md sticky top-0 z-30 border-b border-line/70" data-ui>
	<div class="flex h-14 sm:h-16 w-full items-center justify-between gap-3 px-4 sm:px-6">
		<a
			href="/"
			class="flex shrink-0 items-center gap-2 rounded-lg text-ink no-underline transition-opacity hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
			aria-label="rights.wtf home"
		>
			<div class="flex h-7 w-7 items-center justify-center rounded-xl bg-accent text-on-accent font-bold shadow-sm shadow-accent/25">
				<svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
				</svg>
			</div>
			<span class="text-sm font-bold tracking-tight text-ink">
				rights<span class="text-accent">.wtf</span>
			</span>
		</a>

		<nav class="hidden md:flex items-center gap-6 text-sm font-medium text-ink" aria-label="Main navigation">
			<a href="/#helplines" class="transition-opacity hover:opacity-60">helplines</a>
			<a href="/countries" class="transition-opacity hover:opacity-60">country info</a>
			<a href="/#guide" class="transition-opacity hover:opacity-60">guide</a>
			<a href="/#about" class="transition-opacity hover:opacity-60">about</a>
		</nav>

		<div class="flex shrink-0 items-center gap-2">
			<button
				type="button"
				id="theme-toggle"
				class="flex h-9 w-9 items-center justify-center rounded-lg border border-line text-ink-muted transition-colors hover:bg-accent-soft hover:text-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
				aria-label="Switch to dark theme"
				title="Switch theme"
			>
				<svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<circle cx="12" cy="12" r="4.5" />
					<path stroke-linecap="round" d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4" />
				</svg>
				<svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7z" />
				</svg>
			</button>

			<Button
				href="https://www.google.com"
				id="quick-exit-link"
				variant="danger"
				size="xs"
				class="sm:px-3 sm:text-sm"
				title="Quick exit to Google (Esc 3x also works)"
				aria-label="Quick exit to Google"
			>
				Quick exit
				<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
				</svg>
			</Button>

			<Button
				href="https://hcb.hackclub.com/donations/start/lonersoft"
				target="_blank"
				rel="noopener noreferrer"
				variant="primary"
				shape="pill"
				size="md"
				class="max-sm:hidden"
				aria-label="Donate to Loners can Make Software"
			>
				donate
			</Button>

			<details class="md:hidden relative">
				<summary
					class="flex h-9 w-9 cursor-pointer list-none flex-col items-center justify-center gap-1 rounded-lg text-ink transition-colors hover:bg-accent-soft focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent [&::-webkit-details-marker]:hidden"
					aria-label="Toggle navigation menu"
				>
					<span class="h-0.5 w-5 rounded-full bg-current"></span>
					<span class="h-0.5 w-5 rounded-full bg-current"></span>
					<span class="h-0.5 w-5 rounded-full bg-current"></span>
				</summary>
				<div class="absolute right-0 top-full mt-2 w-60 rounded-xl border border-line bg-surface p-4 shadow-lg shadow-ink/5">
					<nav class="flex flex-col gap-1 text-sm font-medium text-ink">
						<a href="/#helplines" class="rounded-lg px-2 py-2 hover:bg-accent-soft hover:text-accent">helplines</a>
						<a href="/countries" class="rounded-lg px-2 py-2 hover:bg-accent-soft hover:text-accent">country info</a>
						<a href="/#guide" class="rounded-lg px-2 py-2 hover:bg-accent-soft hover:text-accent">guide</a>
						<a href="/#about" class="rounded-lg px-2 py-2 hover:bg-accent-soft hover:text-accent">about</a>
					</nav>
					<div class="mt-2 flex items-center justify-between border-t border-line pt-3">
						<a
							href="https://github.com/lonersoft/rights.wtf"
							target="_blank"
							rel="noopener noreferrer"
							class="text-xs font-medium text-ink-muted hover:text-ink"
						>
							GitHub source &rarr;
						</a>
						<Button
							href="https://hcb.hackclub.com/donations/start/lonersoft"
							target="_blank"
							rel="noopener noreferrer"
							variant="primary"
							shape="pill"
							size="xs"
						>
							donate
						</Button>
					</div>
				</div>
			</details>
		</div>
	</div>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.getElementById("theme-toggle");
	const labelFor = (theme: string) =>
		theme === "dark" ? "Switch to light theme" : "Switch to dark theme";

	const syncLabel = () => {
		if (toggle) toggle.setAttribute("aria-label", labelFor(root.dataset.theme ?? "light"));
	};

	if (toggle) {
		syncLabel();

		toggle.addEventListener("click", () => {
			const next = root.dataset.theme === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			syncLabel();
			try {
				localStorage.setItem("theme", next);
			} catch {
				// private mode: the choice just won't survive a reload
			}
		});

		// If nobody has chosen yet, follow the OS as it changes during the session.
		const media = window.matchMedia("(prefers-color-scheme: dark)");
		media.addEventListener("change", (event) => {
			let stored: string | null = null;
			try {
				stored = localStorage.getItem("theme");
			} catch {
				stored = null;
			}
			if (stored) return;
			root.dataset.theme = event.matches ? "dark" : "light";
			syncLabel();
		});
	}
</script>

---
import type { HTMLAttributes } from "astro/types";
import { TONE_CLASS, type Tone } from "../lib/status";
import { BADGE_SIZE, type BadgeSize } from "../lib/ui";

type Props = HTMLAttributes<"span"> & {
	tone?: Tone;
	shape?: "pill" | "tag";
	size?: BadgeSize;
	border?: boolean;
};

const {
	tone = "neutral",
	shape = "pill",
	size = "xs",
	border = true,
	class: className,
	...rest
} = Astro.props;

const classes = [
	"inline-flex items-center gap-1.5 whitespace-nowrap font-bold",
	shape === "pill" ? "rounded-full" : "rounded-lg",
	BADGE_SIZE[size],
	border ? "border" : "",
	TONE_CLASS[tone],
	className,
];
---

<span class:list={classes} {...rest}><slot /></span>
